params {
    outdir = 'results'
}

outputDir = "${params.outdir}"

plugins {
    id 'nf-iridanext@0.4.0'
}

process {
    withName: METADATA {
        publishDir = [
            path: "${params.outdir}/metadata",
            mode: 'copy',
        ]
    }
}

iridanext {
    enabled = true
    overwrite = true

    output {
        path = "${params.outdir}/iridanext.output.json"
        files {
            global = ["**/metadata/metadata.csv"]
        }
    }

    metadata {
        samples {
            csv {
                path = "**/metadata/metadata.csv"
                idcol = "id"
            }
        }
    }
}

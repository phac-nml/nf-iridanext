params {
    outdir = 'results'
}

outputDir = "${params.outdir}"

plugins {
    id 'nf-iridanext@0.4.0'
}

// Added so older versions of Nextflow can still run validation workflow
nextflow.preview.output = true

iridanext {
    enabled = true
    overwrite = true

    output {
        path = "${params.outdir}/iridanext.output.json"
        files {
            global = ["**/metadata/metadata.csv"]
        }
    }

    metadata {
        samples {
            csv {
                path = "**/metadata/metadata.csv"
                idcol = "id"
            }
        }
    }
}
